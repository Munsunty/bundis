{
  "name": "bundis",
  "version": "0.2.0",
  "description": "RESP3-compatible server backed by SQLite — works with the stock Bun.RedisClient",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "bundis": "src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "CLAUDE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Munsunty/bundis.git"
  },
  "keywords": [
    "redis",
    "resp",
    "resp3",
    "sqlite",
    "bun",
    "redis-server",
    "embedded"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "bun --watch run src/cli.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
